local function getObjectPosition(object)
    if object:IsA("BasePart") then
        return object.Position
    elseif object:IsA("Model") then
        local success, pivot = pcall(function()
            return object:GetPivot()
        end)
        if success then
            return pivot.Position
        end
    end
    return nil
end

local function scanEggs()
    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    local found = {}
    for _, object in ipairs(Workspace:GetDescendants()) do
        if (object:IsA("BasePart") or object:IsA("Model"))
            and string.find(object.Name:lower(), "egg", 1, true) then
            table.insert(found, object)
        end
    end

    table.sort(found, function(a, b)
        return a:GetFullName() < b:GetFullName()
    end)

    if #found == 0 then
        status.Text = "Tidak menemukan objek bernama 'egg' di Workspace."
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, -8, 0, 42)
        empty.BackgroundTransparency = 1
        empty.Text = "Tidak ada objek yang cocok."
        empty.TextColor3 = Color3.fromRGB(190, 190, 205)
        empty.Font = Enum.Font.Gotham
        empty.TextSize = 12
        empty.Parent = list
        return
    end

    local maxItems = math.min(#found, 150)
    status.Text = "Ditemukan " .. #found .. " objek • menampilkan " .. maxItems

    for index = 1, maxItems do
        local object = found[index]
        local pos = getObjectPosition(object)
        local positionText = pos
            and string.format("X %.0f  Y %.0f  Z %.0f", pos.X, pos.Y, pos.Z)
            or "Posisi tidak tersedia"

        local button = makeButton(
            list,
            object.Name .. "  •  " .. positionText,
            UDim2.new(1, -4, 0, 38),
            UDim2.new(0, 0, 0, 0),
            Color3.fromRGB(48, 42, 69)
        )
        button.TextTruncate = Enum.TextTruncate.AtEnd
        button.TextXAlignment = Enum.TextXAlignment.Left

        button.Activated:Connect(function()
            local currentPosition = getObjectPosition(object)
            if not object:IsDescendantOf(Workspace) then
                status.Text = "Objek sudah tidak ada di Workspace."
            elseif currentPosition then
                status.Text = object.Name .. " • " ..
                    string.format("X %.1f, Y %.1f, Z %.1f",
                    currentPosition.X, currentPosition.Y, currentPosition.Z)
            else
                status.Text = "Posisi objek tidak tersedia."
            end
        end)
    end
end

refresh.Activated:Connect(scanEggs)
scanEggs()
